#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  install-host [options] <host> <target>

Examples:
  install-host kamo nixos@192.168.0.99
  install-host --no-install kamo nixos@192.168.0.99

Target requirements:
  - Booted into the official NixOS ISO
  - Network connected
  - Password set for the nixos user
  - SSH reachable, usually as nixos@<ip>

What this script does:
  - checks the local flake host
  - creates a temporary SSH key
  - authenticates once with the installer password
  - installs the temporary SSH public key on the installer
  - reuses that key for all subsequent SSH connections
  - checks/fixes large clock skew on the installer
  - shows remote disk IDs for comparison with hosts/<host>/storage/disko.nix
  - writes hosts/<host>/generated/hardware-configuration.nix
  - writes hosts/<host>/generated/ssh_host_ed25519_key.pub
  - prepares /tmp/<host>/etc/ssh for nixos-anywhere --extra-files
  - runs agenix rekey
  - stages generated host files and rekeyed secrets for final evaluation
  - evaluates the host
  - optionally runs nixos-anywhere

Options:
  --no-install       Prepare generated files and rekey, but do not run nixos-anywhere
  --no-rekey         Do not run agenix rekey
  --force            Skip confirmation prompts except destructive install confirmation
  -h, --help         Show this help
USAGE
}

die() {
  echo "error: $*" >&2
  exit 1
}

info() {
  echo
  echo "==> $*"
}

warn() {
  echo "warning: $*" >&2
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

confirm() {
  local prompt="$1"
  local answer

  if [[ "$force" == "1" ]]; then
    echo "$prompt [auto-yes due to --force]"
    return 0
  fi

  read -r -p "$prompt [y/N] " answer
  case "$answer" in
    y|Y|yes|YES) ;;
    *) die "aborted" ;;
  esac
}

# ---------------------------------------------------------------------------
# SSH helpers
# ---------------------------------------------------------------------------

ssh_tmp=""
ssh_key=""
ssh_known_hosts=""

cleanup() {
  if [[ -n "$ssh_tmp" && -d "$ssh_tmp" ]]; then
    rm -rf "$ssh_tmp"
  fi
}

trap cleanup EXIT INT TERM

setup_ssh() {
  ssh_tmp="$(mktemp -d)"
  ssh_key="${ssh_tmp}/id_ed25519"
  ssh_known_hosts="${ssh_tmp}/known_hosts"

  ssh-keygen \
    -q \
    -t ed25519 \
    -N "" \
    -C "nixos-anywhere temporary installer key" \
    -f "$ssh_key"

  touch "$ssh_known_hosts"
  chmod 600 "$ssh_known_hosts"
}

# SSH connection used after the initial password bootstrap.
remote_ssh() {
  ssh \
    -i "$ssh_key" \
    -o IdentitiesOnly=yes \
    -o "UserKnownHostsFile=${ssh_known_hosts}" \
    -o StrictHostKeyChecking=accept-new \
    "$@"
}

bootstrap_ssh_key() {
  local target="$1"

  info "Installing temporary SSH key"
  echo "The installer password should be requested once here."

  cat "${ssh_key}.pub" |
    ssh \
      -o "UserKnownHostsFile=${ssh_known_hosts}" \
      -o StrictHostKeyChecking=accept-new \
      "$target" \
      '
        set -eu

        umask 077
        mkdir -p ~/.ssh
        touch ~/.ssh/authorized_keys

        key="$(cat)"

        if ! grep -qxF "$key" ~/.ssh/authorized_keys; then
          printf "%s\n" "$key" >> ~/.ssh/authorized_keys
        fi
      '

  info "Checking key-based SSH connectivity"
  remote_ssh "$target" 'echo connected'
}

# ---------------------------------------------------------------------------
# Clock
# ---------------------------------------------------------------------------

check_remote_clock() {
  local target="$1"
  local local_epoch
  local remote_epoch
  local diff

  local_epoch="$(date +%s)"
  remote_epoch="$(remote_ssh "$target" 'date +%s')"

  if (( local_epoch >= remote_epoch )); then
    diff=$((local_epoch - remote_epoch))
  else
    diff=$((remote_epoch - local_epoch))
  fi

  if (( diff <= 300 )); then
    echo "Clock difference: ${diff}s"
    return
  fi

  warn "installer clock differs from local clock by ${diff}s"
  info "Synchronizing installer clock"

  # Set a sane clock immediately. The live ISO is ephemeral, so changing its
  # clock here is safe and avoids TLS/tar/Nix failures caused by large skew.
  remote_ssh "$target" \
    "sudo date -u -s '@${local_epoch}' >/dev/null"

  # Let NTP take over afterwards when available.
  remote_ssh "$target" \
    'sudo timedatectl set-ntp true >/dev/null 2>&1 || true'

  remote_epoch="$(remote_ssh "$target" 'date +%s')"
  local_epoch="$(date +%s)"

  if (( local_epoch >= remote_epoch )); then
    diff=$((local_epoch - remote_epoch))
  else
    diff=$((remote_epoch - local_epoch))
  fi

  echo "Clock difference after synchronization: ${diff}s"
}

# ---------------------------------------------------------------------------
# Remote inspection/generation
# ---------------------------------------------------------------------------

show_disk_ids() {
  local target="$1"

  remote_ssh "$target" \
    'ls -l /dev/disk/by-id/ | sed -n "1,200p"'
}

generate_hardware_config() {
  local host="$1"
  local target="$2"
  local file="hosts/${host}/generated/hardware-configuration.nix"

  mkdir -p "hosts/${host}/generated"

  if [[ -f "$file" ]]; then
    cp "$file" "${file}.bak"
    echo "backup: ${file}.bak"
  fi

  remote_ssh "$target" \
    'nixos-generate-config --no-filesystems --show-hardware-config' \
    > "$file"

  echo "wrote: $file"
}

write_host_key_file() {
  local host="$1"
  local target="$2"
  local file="hosts/${host}/generated/ssh_host_ed25519_key.pub"

  mkdir -p "hosts/${host}/generated"

  remote_ssh "$target" \
    'cat /etc/ssh/ssh_host_ed25519_key.pub' \
    > "$file"

  echo "wrote: $file"
  echo "public key: $(cat "$file")"
}

stage_generated_host_public_key() {
  local host="$1"

  git add -- "hosts/${host}/generated/ssh_host_ed25519_key.pub"
}

stage_generated_host_files() {
  local host="$1"

  git add -- \
    "hosts/${host}/generated/hardware-configuration.nix" \
    "hosts/${host}/generated/ssh_host_ed25519_key.pub"
}

stage_rekeyed_secrets() {
  local host="$1"
  local dir="secrets/rekeyed/${host}"

  if [[ -d "$dir" ]]; then
    git add -A -- "$dir"
  fi
}

prepare_extra_files() {
  local host="$1"
  local target="$2"
  local extra_dir="/tmp/${host}"

  rm -rf "$extra_dir"
  mkdir -p "$extra_dir/etc/ssh"

  remote_ssh "$target" \
    'sudo tar -C /etc/ssh -cf - ssh_host_ed25519_key ssh_host_ed25519_key.pub' \
    | tar -C "$extra_dir/etc/ssh" -xf -

  chmod 600 "$extra_dir/etc/ssh/ssh_host_ed25519_key"
  chmod 644 "$extra_dir/etc/ssh/ssh_host_ed25519_key.pub"

  echo "$extra_dir"
}

# ---------------------------------------------------------------------------
# Arguments
# ---------------------------------------------------------------------------

no_install=0
no_rekey=0
force=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-install)
      no_install=1
      shift
      ;;

    --no-rekey)
      no_rekey=1
      shift
      ;;

    --force)
      force=1
      shift
      ;;

    -h|--help)
      usage
      exit 0
      ;;

    --)
      shift
      break
      ;;

    -*)
      die "unknown option: $1"
      ;;

    *)
      break
      ;;
  esac
done

host="${1:-}"
target="${2:-}"

[[ -n "$host" ]] || {
  usage
  exit 1
}

[[ -n "$target" ]] || {
  usage
  exit 1
}

[[ $# -le 2 ]] ||
  die "disk argument was removed; edit hosts/${host}/storage/disko.nix instead"

# ---------------------------------------------------------------------------
# Local validation
# ---------------------------------------------------------------------------

[[ -f flake.nix ]] ||
  die "run this script from the flake root"

[[ -d "hosts/$host" ]] ||
  die "hosts/$host does not exist"

[[ -f "hosts/$host/storage/disko.nix" ]] ||
  die "hosts/$host/storage/disko.nix does not exist"

require_cmd ssh
require_cmd ssh-keygen
require_cmd tar
require_cmd nix
require_cmd chmod
require_cmd date

if [[ "$no_rekey" != "1" ]]; then
  require_cmd agenix
fi

info "Install target"
echo "Host:   $host"
echo "Target: $target"

info "Checking flake host"
nix eval \
  --raw \
  ".#nixosConfigurations.${host}.config.networking.hostName" \
  >/dev/null

# ---------------------------------------------------------------------------
# SSH bootstrap
# ---------------------------------------------------------------------------

setup_ssh
bootstrap_ssh_key "$target"

# ---------------------------------------------------------------------------
# Clock
# ---------------------------------------------------------------------------

info "Checking installer clock"
check_remote_clock "$target"

# ---------------------------------------------------------------------------
# Disk confirmation
# ---------------------------------------------------------------------------

info "Remote disk IDs"
show_disk_ids "$target"
echo

info "Host disko configuration"
echo "Using: hosts/${host}/storage/disko.nix"

confirm "Continue using this disko configuration for ${host}?"

# ---------------------------------------------------------------------------
# Generate machine-specific state
# ---------------------------------------------------------------------------

info "Generating hardware configuration"
generate_hardware_config "$host" "$target"

info "Reading ISO SSH host public key"
write_host_key_file "$host" "$target"

info "Staging generated host public key"
stage_generated_host_public_key "$host"

info "Preparing extra-files with ISO SSH host keys"
extra_dir="$(prepare_extra_files "$host" "$target")"
echo "prepared: $extra_dir"

# ---------------------------------------------------------------------------
# Agenix
# ---------------------------------------------------------------------------

if [[ "$no_rekey" != "1" ]]; then
  info "Rekeying agenix secrets"
  agenix rekey
else
  warn "skipping agenix rekey due to --no-rekey"
fi

info "Staging generated host files"
stage_generated_host_files "$host"

if [[ "$no_rekey" != "1" ]]; then
  info "Staging rekeyed secrets"
  stage_rekeyed_secrets "$host"
fi

# ---------------------------------------------------------------------------
# Final evaluation
# ---------------------------------------------------------------------------

info "Evaluating host"

nix eval \
  --raw \
  ".#nixosConfigurations.${host}.config.system.build.toplevel.drvPath" \
  >/dev/null

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------

info "Summary"

echo "Host:       $host"
echo "Target:     $target"
echo "Disko:      hosts/${host}/storage/disko.nix"
echo "ExtraFiles: $extra_dir"
echo

echo "Generated or updated:"
echo "  hosts/${host}/generated/hardware-configuration.nix"
echo "  hosts/${host}/generated/ssh_host_ed25519_key.pub"
echo

if [[ "$no_install" == "1" ]]; then
  echo "--no-install was specified. Skipping nixos-anywhere."
  exit 0
fi

# ---------------------------------------------------------------------------
# Destructive confirmation
# ---------------------------------------------------------------------------

echo "This will install NixOS using hosts/${host}/storage/disko.nix"
echo "and may destroy existing data on the configured disk."
echo

read -r -p "Type '${host}' to start nixos-anywhere: " typed

[[ "$typed" == "$host" ]] ||
  die "host confirmation did not match"

# ---------------------------------------------------------------------------
# Installation
# ---------------------------------------------------------------------------

info "Running nixos-anywhere"

nix run github:nix-community/nixos-anywhere -- \
  --flake ".#${host}" \
  --extra-files "$extra_dir" \
  -i "$ssh_key" \
  --ssh-option "IdentitiesOnly=yes" \
  --ssh-option "UserKnownHostsFile=${ssh_known_hosts}" \
  --ssh-option "StrictHostKeyChecking=accept-new" \
  "$target"

info "Installation completed"
