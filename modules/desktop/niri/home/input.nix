{
  programs.niri.settings.input = {
    keyboard = {
      xkb.options = "caps:none";
      repeat-delay = 300;
      repeat-rate = 50;
    };

    touchpad = {
      tap = true;
      natural-scroll = true;
      accel-speed = 1.0;
    };

    mouse = {
      accel-speed = 0.0;
      accel-profile = "flat";
    };

    trackpoint = {
      accel-speed = 1.0;
      accel-profile = "flat";
    };
  };
}
